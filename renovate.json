{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "rebaseWhen": "conflicted",
  "separateMultipleMajor": true,
  "gitAuthor": "Renovate <renovate@oztechan.com>",
  "commitBody": "Co-authored-by: Mustafa Ozhan <mr.mustafa.ozhan@gmail.com>",
  "commitMessageAction": "[Oztechan/Global#12] Update",
  "prConcurrentLimit": 20,
  "git-submodules": {
    "enabled": true,
    "groupName": "Git Submodules"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessageAction": "[Oztechan/Global#12] Lock file maintenance",
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^$/"
      ],
      "matchStrings": [
        "repositoryURL = \"https://github.com/(?<depName>[^/]+/[^\"/]+?)(?:\\.git)?\";\\s*requirement = \\{\\s*kind = exactVersion;\\s*version = (?<currentValue>[^;]+);"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "Everything below a major bump is gated by CI, not by reading the diff.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": [
        "/^org.jetbrains.kotlin.$/"
      ]
    },
    {
      "groupName": "koin",
      "matchPackageNames": [
        "/^io.insert-koin/"
      ]
    },
    {
      "groupName": "submob",
      "matchPackageNames": [
        "/^com.github.submob:/"
      ]
    }
  ]
}
